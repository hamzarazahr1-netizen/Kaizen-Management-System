{
  "entities": {
    "Kaizen": {
      "title": "Kaizen",
      "description": "A Kaizen submission for process improvement across Master Group of Industries factories in Karachi, Lahore, and Mirpur",
      "type": "object",
      "properties": {
        "id": { "type": "string", "maxLength": 128, "pattern": "^[a-zA-Z0-9_\\-]+$" },
        "location": {
          "type": "string",
          "enum": ["Karachi", "Lahore", "Mirpur"]
        },
        "factory": {
          "type": "string",
          "enum": [
            "Master Lifestyle Pvt. Ltd.",
            "Master Molty Foam",
            "Karachi Furniture Factory",
            "Karachi Molty Foam Port Qasim"
          ]
        },
        "department": { "type": "string", "maxLength": 100 },
        "initiator": { "type": "string", "maxLength": 100 },
        "submissionDate": { "type": "string", "maxLength": 40 },
        "presentationDate": { "type": "string", "maxLength": 40 },
        "type": { "type": "string", "enum": ["Idea", "Implemented"] },
        "status": { "type": "string", "enum": ["Pending", "Accepted", "Rejected"] },
        "problem": { "type": "string", "maxLength": 10000 },
        "solution": { "type": "string", "maxLength": 10000 },
        "challenges": { "type": "string", "maxLength": 5000 },
        "impact": {
          "type": "object",
          "properties": {
            "costSaving": { "type": "boolean" },
            "productivity": { "type": "boolean" },
            "quality": { "type": "boolean" },
            "safety": { "type": "boolean" },
            "delivery": { "type": "boolean" }
          }
        },
        "reward": { "type": "number" },
        "feedback": { "type": "string", "maxLength": 5000 },
        "month": { "type": "string", "maxLength": 30 },
        "beforeImg": { "type": "string", "maxLength": 900000 },
        "afterImg": { "type": "string", "maxLength": 900000 },
        "evaluation": {
          "type": "object",
          "properties": {
            "scores": {
              "type": "object",
              "properties": {
                "problemIdentification": { "type": "number" },
                "rootCauseAnalysis": { "type": "number" },
                "creativityInnovation": { "type": "number" },
                "impactOnResults": { "type": "number" },
                "sustainability": { "type": "number" },
                "employeeInvolvement": { "type": "number" },
                "abilityToYokoten": { "type": "number" }
              }
            },
            "aggregateScore": { "type": "number" },
            "percentage": { "type": "number" },
            "evaluatedAt": { "type": "string", "maxLength": 40 }
          }
        },
        "createdAt": { "type": "string", "format": "date-time" },
        "updatedAt": { "type": "string", "format": "date-time" }
      },
      "required": ["id", "location", "factory", "department", "initiator", "submissionDate", "type", "status", "problem", "solution", "month"]
    },
    "PortalSettings": {
      "title": "PortalSettings",
      "description": "Permanent QR code base URL and optional live redirect target shared across all facilities",
      "type": "object",
      "properties": {
        "permanentBaseUrl": { "type": "string", "maxLength": 300, "pattern": "^https?://.*" },
        "liveTargetUrl": { "type": "string", "maxLength": 300 },
        "updatedAt": { "type": "string", "maxLength": 40 }
      },
      "required": ["permanentBaseUrl"]
    }
  },
  "firestore": {
    "/kaizens": {
      "schema": "Kaizen",
      "description": "Collection of all Kaizen submissions across Karachi, Lahore, and Mirpur factories"
    },
    "/settings": {
      "schema": "PortalSettings",
      "description": "Singleton portal configuration storing permanent shopfloor QR link and live target URL"
    }
  }
}
